<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RhinoSystemPath Condition="'$(RhinoSystemPath)' == ''">C:\Program Files\Rhino 8\System</RhinoSystemPath>
    <GazellePluginPath Condition="'$(GazellePluginPath)' == ''">$(MSBuildThisFileDirectory)..\..\AssemblyManagerPlugin\bin\Release\net7.0\Gazelle.rhp</GazellePluginPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Gazelle" HintPath="$(GazellePluginPath)" Private="false" />
    <Reference Include="Eto" HintPath="$(RhinoSystemPath)\Eto.dll" Private="false" />
  </ItemGroup>
</Project>
